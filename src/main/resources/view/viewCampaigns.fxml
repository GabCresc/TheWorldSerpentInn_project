<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: white" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="logic.graphiccontrollers.GcCampaignList">
    <children>
        <Pane fx:id="scalesBackground" layoutY="94.0" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-image: url('/icons/snake_pattern_wallpaper.jpg'); -fx-background-repeat: repeat; -fx-background-size: 250px 150px">
            <children>
                <Pagination fx:id="pagination" layoutX="31.0" layoutY="79.0" maxPageIndicatorCount="5" pageCount="5" prefHeight="623.0" prefWidth="1335.0" />
                <Label alignment="CENTER" layoutX="46.0" layoutY="25.0" prefHeight="17.0" prefWidth="1328.0" text="Lista Campagne Disponibili" textAlignment="CENTER">
                    <font>
                        <Font name="Britannic Bold" size="36.0" />
                    </font>
                </Label>
                <TextField fx:id="filterField" layoutX="641.0" layoutY="86.0" prefHeight="25.0" prefWidth="274.0" promptText="Inserisci il nome della campagna" />
                <ComboBox fx:id="filterMenu" layoutX="475.0" layoutY="86.0" prefWidth="150.0" />
                <Button fx:id="searchButton" layoutX="931.0" layoutY="86.0" mnemonicParsing="false" onAction="#searchAction" prefHeight="25.0" prefWidth="93.0" text="Cerca" />
                <Label alignment="CENTER" layoutX="189.0" layoutY="85.0" prefHeight="27.0" prefWidth="274.0" style="-fx-background-color: white; -fx-border-color: green;" text="Seleziona la modalità desiderata:">
                    <font>
                        <Font size="18.0" />
                    </font></Label>
                <Label fx:id="errorLabel" alignment="CENTER" layoutX="-1.0" layoutY="605.0" prefHeight="27.0" prefWidth="1280.0" textAlignment="CENTER" textFill="RED">
                    <font>
                        <Font size="18.0" />
                    </font></Label>
            </children>
            <effect>
                <Blend opacity="0.56" />
            </effect></Pane>
        <Hyperlink fx:id="title" layoutX="126.0" onAction="#showHomePage" prefHeight="94.0" prefWidth="597.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="World Serpent Inn">
            <font>
                <Font name="Eras Bold ITC" size="60.0" />
            </font>
        </Hyperlink>
        <Hyperlink fx:id="showCampaigns" layoutX="758.0" layoutY="59.0" onAction="#showShowCampaigns" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Vedi campagne" />
        <Hyperlink fx:id="showPg" layoutX="872.0" layoutY="59.0" onAction="#showShowPg" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Vedi pg" />
        <Hyperlink fx:id="createCampaigns" layoutX="938.0" layoutY="59.0" onAction="#showCreateCampaign" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Crea Campagna" />
        <Hyperlink fx:id="showCreateCharacter" layoutX="1058.0" layoutY="59.0" onAction="#showCreatePg" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Crea pg" />
        <ImageView fitHeight="80.0" fitWidth="80.0" layoutX="31.0" layoutY="8.0">
            <image>
                <Image url="@../icons/imm.png" />
            </image>
        </ImageView>
        <MenuButton fx:id="userMenuButton" layoutX="1189.0" layoutY="56.0" mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ccc; -fx-border-radius: 10;" text="MenuButton">
            <items>
                <MenuItem fx:id="logoutItem" mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
            </items>
        </MenuButton>
        <ImageView fx:id="notificationIcon" fitHeight="27.0" fitWidth="29.0" layoutX="1136.0" layoutY="56.0" onMouseClicked="#loadNotifications">
            <image>
                <Image url="@../icons/notification.png" />
            </image>
        </ImageView>
    </children>
</AnchorPane>