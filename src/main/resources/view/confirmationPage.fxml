<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: white" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="logic.graphiccontrollers.GcConfirmation">
    <children>
        <Pane fx:id="scalesBackground" layoutY="94.0" prefHeight="691.0" prefWidth="1328.0" style="-fx-background-image: url('/icons/snake_pattern_wallpaper.jpg'); -fx-background-repeat: repeat; -fx-background-size: 250px 150px;">
            <children>
                <Label layoutX="65.0" layoutY="162.0" prefHeight="109.0" prefWidth="1191.0" style="-fx-background-color: white;" text="Richiesta di partecipazione inviata! Premi il bottone per tornare alla homepage!">
                    <font>
                        <Font name="Bell MT" size="36.0" />
                    </font>
                </Label>
                <Button fx:id="goBackButton" layoutX="565.0" layoutY="327.0" mnemonicParsing="false" onAction="#goBackAction" prefHeight="94.0" prefWidth="196.0" style="-fx-background-color: green; -fx-background-radius: 5; -fx-font-size: 22; -fx-text-fill: white;" text="Torna indietro">
                    <font>
                        <Font size="18.0" />
                    </font></Button>
                <Label fx:id="errorLabel" alignment="CENTER" layoutX="451.0" layoutY="100.0" prefHeight="39.0" prefWidth="426.0" style="-fx-background-color: white;" textFill="#e70909">
                    <font>
                        <Font size="18.0" />
                    </font></Label>
            </children></Pane>
        <Hyperlink layoutX="126.0" prefHeight="94.0" prefWidth="597.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="World Serpent Inn">
            <font>
                <Font name="Eras Bold ITC" size="60.0" />
            </font>
        </Hyperlink>
        <Hyperlink layoutX="758.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Vedi campagne" />
        <Hyperlink layoutX="872.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Vedi pg" />
        <Hyperlink layoutX="938.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Crea Campagna" />
        <Hyperlink layoutX="1058.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Crea pg" />
        <ImageView fitHeight="80.0" fitWidth="80.0" layoutX="31.0" layoutY="8.0">
            <image>
                <Image url="@../icons/imm.png" />
            </image>
        </ImageView>
        <MenuButton fx:id="userMenuButton" layoutX="1189.0" layoutY="56.0" mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ccc; -fx-border-radius: 10;" text="MenuButton">
            <items>
                <MenuItem fx:id="logoutItem" mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
            </items>
        </MenuButton>
        <ImageView fx:id="notificationIcon" fitHeight="27.0" fitWidth="29.0" layoutX="1136.0" layoutY="56.0" onMouseClicked="#loadNotifications">
            <image>
                <Image url="@../icons/notification.png" />
            </image>
        </ImageView>
    </children>
</AnchorPane>