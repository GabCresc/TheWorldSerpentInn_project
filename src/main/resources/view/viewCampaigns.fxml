<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: white" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="logic.graphiccontrollers.GcCampaignList">
    <children>
        <Pane fx:id="scalesBackground" layoutY="94.0" prefHeight="691.0" prefWidth="1328.0" style="-fx-background-image: url('/icons/snake_pattern_wallpaper.jpg'); -fx-background-repeat: repeat; -fx-background-size: 250px 150px">
         <children>
            <Pagination fx:id="pagination" layoutX="31.0" layoutY="-4.0" maxPageIndicatorCount="5" prefHeight="698.0" prefWidth="1335.0" />
            <Label alignment="CENTER" layoutX="46.0" layoutY="25.0" prefHeight="17.0" prefWidth="1328.0" text="Lista Campagne Disponibili" textAlignment="CENTER">
               <font>
                  <Font name="Britannic Bold" size="36.0" />
               </font>
            </Label>
            <TextField fx:id="filterField" layoutX="641.0" layoutY="86.0" prefHeight="25.0" prefWidth="274.0" />
            <ComboBox fx:id="filterMenu" layoutX="475.0" layoutY="86.0" prefWidth="150.0" />
            <Button fx:id="searchButton" layoutX="931.0" layoutY="86.0" mnemonicParsing="false" onAction="#searchAction" prefHeight="25.0" prefWidth="93.0" text="Cerca" />
            <Label layoutX="265.0" layoutY="90.0" prefHeight="17.0" prefWidth="187.0" text="Seleziona la modalità desiderata:" />
         </children></Pane>
        <Hyperlink layoutX="126.0" prefHeight="94.0" prefWidth="597.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="World Serpent Inn">
            <font>
                <Font name="Eras Bold ITC" size="60.0" />
            </font>
        </Hyperlink>
        <Hyperlink fx:id="showCampaigns" layoutX="758.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Vedi campagne" />
        <Hyperlink fx:id="showCharacters" layoutX="872.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Vedi pg" />
        <Hyperlink fx:id="showCreateCampaigns" layoutX="938.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Crea Campagna" />
        <Hyperlink fx:id="showCreateCharacter" layoutX="1058.0" layoutY="59.0" style="-fx-text-fill: black; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-underline: false;" text="Crea pg" />
        <ImageView fitHeight="80.0" fitWidth="80.0" layoutX="31.0" layoutY="8.0">
            <image>
                <Image url="@../icons/imm.png" />
            </image>
        </ImageView>
      <MenuButton fx:id="menu" layoutX="1189.0" layoutY="56.0" mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #ccc; -fx-border-radius: 10;" text="MenuButton">
        <items>
          <MenuItem fx:id="logoutItem" mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
        </items>
      </MenuButton>
    </children>
</AnchorPane>
